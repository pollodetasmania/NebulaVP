# Copia este archivo con el nombre .env y completa los datos.
# Si los dejas vacíos, la app funciona en modo demostración (solo en tu navegador).

# Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Número inicial de WhatsApp (WHATSAPP_NUMBER): indicativo + número, solo dígitos.
# También se puede cambiar después en /admin > Configuración.
VITE_WHATSAPP_NUMBER=
